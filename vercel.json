{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "supabase-schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/sms/verify-receipt/:transactionId",
      "destination": "/api/index?__route=sms/verify-receipt&transactionId=:transactionId"
    },
    {
      "source": "/api/((?!index$).*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
